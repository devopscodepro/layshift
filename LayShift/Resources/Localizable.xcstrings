    "LayShift keeps working in the background. To open Settings again, launch LayShift from Launchpad, Spotlight or the Applications folder." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LayShift продолжает работать в фоне. Чтобы снова открыть настройки, запустите LayShift из Launchpad, Spotlight или папки «Программы»."
          }
        }
      }
    },
    "LayShift, current layout %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LayShift, текущая раскладка %@"
