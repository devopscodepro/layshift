      }
    },
    "Left" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Левый"
          }
        }
      }
    },
    "macOS also acts on the 🌐 key. Set “Press 🌐 key to” to “Do Nothing” in Keyboard settings." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS тоже реагирует на клавишу 🌐. В настройках клавиатуры выберите для «Нажатие клавиши 🌐» вариант «Ничего не делать»."
          }
        }
      }
    },
    "macOS didn't accept %@. Pick a different shortcut." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не приняла %@. Выберите другое сочетание."
